# Copy to .env and adjust. Real secrets never go in git (.env is gitignored).
# Generate strong values with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- docker compose ---
# PostgreSQL password (URL-safe characters only: it is embedded in a connection URL).
POSTGRES_PASSWORD=change-me-too
# Linux only: GID of the docker group, so agents need not run as root.
#   getent group docker | cut -d: -f3
# DOCKER_GID=999

# --- Backend (device_mgmt) ---
# REQUIRED. Operator credential sent as the X-API-Key header. At least 16 characters.
DEVICE_MGMT_ADMIN_API_KEY=change-me-to-a-long-random-value
# SQLite for local development; PostgreSQL in compose/production, e.g.
# DEVICE_MGMT_DATABASE_URL=postgresql+psycopg://user:password@db:5432/device_mgmt
DEVICE_MGMT_DATABASE_URL=sqlite:///./device_mgmt.db
# Reject plain-HTTP requests and send HSTS. Enable behind a TLS-terminating proxy.
DEVICE_MGMT_REQUIRE_HTTPS=false
DEVICE_MGMT_HEARTBEAT_STALE_AFTER_SECONDS=90
DEVICE_MGMT_HEARTBEAT_OFFLINE_AFTER_SECONDS=300
DEVICE_MGMT_LOG_LEVEL=INFO

# --- Device agent (edge_agent) ---
EDGE_AGENT_DEVICE_ID=device-001
EDGE_AGENT_BACKEND_URL=https://localhost:8443
# Token returned once by POST /devices. Prefer a file over an env var:
#   EDGE_AGENT_DEVICE_TOKEN_FILE=/run/secrets/device_token
EDGE_AGENT_DEVICE_TOKEN=issued-at-registration
# Extra CA certificates (PEM) when the backend uses a private CA.
# EDGE_AGENT_CA_BUNDLE=/etc/edge-agent/ca.pem
EDGE_AGENT_HEARTBEAT_INTERVAL_SECONDS=30
