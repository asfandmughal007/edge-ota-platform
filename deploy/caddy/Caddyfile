# TLS termination for the backend. `tls internal` issues a certificate from
# Caddy's own local CA, which is fine for development. In production use a
# real hostname and Caddy obtains a public certificate automatically, or
# point `tls` at certificates from your own PKI.
#
# Caddy sets X-Forwarded-Proto: https, which the backend honours when
# DEVICE_MGMT_REQUIRE_HTTPS=true.
{
	auto_https disable_redirects
}

https://localhost:8443 {
	tls internal
	reverse_proxy backend:8000
}
